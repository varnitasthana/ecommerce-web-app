{
  "name": "ecommerce-web-app",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm --prefix server run dev\" \"npm --prefix client run dev -- --host 0.0.0.0\"",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/dev-clean.ps1",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev -- --host 0.0.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
